# Vyapaar Kavach — Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# ─── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development           # development | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-min-32-chars

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default — zero config, works out of the box)
DATABASE_URL=sqlite:///./vyapaar_kavach.db
# PostgreSQL (production-ready, recommended for hackathon demo)
# DATABASE_URL=postgresql://user:password@localhost:5432/vyapaar_kavach

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ─── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── IBM watsonx.ai (SmurfPakad GATv2 ML) ────────────────────────────────────
WATSON_API_KEY=your-ibm-watson-api-key
WATSON_PROJECT_ID=your-watsonx-project-id
WATSON_URL=https://us-south.ml.cloud.ibm.com

# ─── Vyapaar Kavach — ONDC ───────────────────────────────────────────────────
ONDC_NETWORK_URL=https://api.ondc.org/v1
ONDC_SUBSCRIBER_ID=your-ondc-subscriber-id
ONDC_PRIVATE_KEY=your-ondc-private-key-base64

# ─── ZK Proof System ─────────────────────────────────────────────────────────
# Set to true to use real snarkjs Groth16 (requires Node + circom setup)
# See docs/ZK_SETUP.md for instructions
ZK_USE_REAL_SNARK=false
ZK_CIRCUIT_WASM_PATH=./zk/dispute_anomaly.wasm
ZK_CIRCUIT_ZKEY_PATH=./zk/dispute_anomaly.zkey

# ─── ONNX Edge AI ─────────────────────────────────────────────────────────────
# Set to true to load a real ONNX SLM model for Hinglish NLP
ONNX_USE_REAL_MODEL=false
ONNX_MODEL_PATH=./models/slm_hinglish_int8.onnx

# ─── eBPF Monitoring ─────────────────────────────────────────────────────────
# Set to true on Linux with CAP_BPF to enable real eBPF probes
EBPF_ENABLED=false

# ─── Payment Providers (Refund APIs) ─────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
PAYTM_MERCHANT_ID=your-paytm-merchant-id
PAYTM_MERCHANT_KEY=your-paytm-merchant-key
PHONEPE_MERCHANT_ID=your-phonepe-merchant-id
PHONEPE_SALT_KEY=your-phonepe-salt-key